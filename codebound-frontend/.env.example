# Required: backend API base URL (update port if different)
VITE_BACKEND_BASE_URL="http://localhost:3000"
# Required: cookie name for auth token
VITE_TOKEN_NAME="codebound_token"
# Required: must match backend API_KEY
VITE_API_KEY=""

# Optional: uncomment if using WebSocket
# VITE_BACKEND_WS_BASE_URL="ws://localhost:3000"
# Optional: app display name (not used in code yet)
# VITE_BRAND_NAME="CodeBound"
# Optional: production server (not used in code yet)
# PROD_SERVER_HOST="127.0.0.1"
# PROD_SERVER_ALLOWED_HOST="localhost"